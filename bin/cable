#!/usr/bin/env php
<?php

use App\Support\Broadcasts;
use App\Support\RailsCrypto;
use Illuminate\Support\Facades\DB;
use Workerman\Connection\TcpConnection;
use Workerman\Protocols\Http\Request;
use Workerman\Timer;
use Workerman\Worker;

require dirname(__DIR__).'/vendor/autoload.php';
$app = require dirname(__DIR__).'/bootstrap/app.php';
$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();

function validSession(TcpConnection $connection): bool
{
    return isset($connection->userId) && DB::table('sessions')->join('users', 'users.id', '=', 'sessions.user_id')->where('sessions.id', $connection->sessionId)->where('users.status', 0)->where('users.role', '!=', 2)->exists();
}

function releasePresence(TcpConnection $connection, array $subscription): void
{
    if ($subscription['channel'] === 'PresenceChannel') {
        DB::table('memberships')->where('user_id', $connection->userId)->where('room_id', $subscription['room'])->update(['connections' => DB::raw('MAX(connections-1,0)'), 'connected_at' => DB::raw('CASE WHEN connections<=1 THEN NULL ELSE connected_at END')]);
    }
}

$server = new Worker('websocket://127.0.0.1:'.getenv('CABLE_PORT'));
$server->count = 1;
$server->name = 'CampfireActionCable';
Worker::$pidFile = storage_path('cable.pid');
Worker::$logFile = storage_path('logs/workerman.log');
$server->onWebSocketConnect = function (TcpConnection $connection, Request $request) {
    if (!in_array('actioncable-v1-json', array_map('trim', explode(',', $request->header('sec-websocket-protocol', ''))))) {
        $connection->close();
        return;
    }
    $connection->headers[] = 'Sec-WebSocket-Protocol: actioncable-v1-json';
    $scheme = $request->header('x-forwarded-proto', 'http');
    $expected = parse_url($scheme.'://'.$request->header('host'));
    $actual = parse_url($request->header('origin', ''));
    $defaultPort = $scheme === 'https' ? 443 : 80;
    if (!$actual || ($actual['scheme'] ?? '') !== $scheme || ($actual['host'] ?? '') !== ($expected['host'] ?? '') || ($actual['port'] ?? $defaultPort) !== ($expected['port'] ?? $defaultPort)) {
        $connection->close();
        return;
    }
    $cookie = $request->cookie('session_token');
    $token = app(RailsCrypto::class)->verifyCookie('session_token', is_string($cookie) ? urldecode($cookie) : null);
    $session = is_string($token) ? DB::table('sessions')->join('users', 'users.id', '=', 'sessions.user_id')->where('sessions.token', $token)->where('users.status', 0)->where('users.role', '!=', 2)->select('sessions.id as session_id', 'users.id as user_id', 'users.name')->first() : null;
    if (!$session) {
        $connection->send(json_encode(['type' => 'disconnect', 'reason' => 'unauthorized', 'reconnect' => false]));
        $connection->close();
        return;
    }
    $connection->userId = $session->user_id;
    $connection->sessionId = $session->session_id;
    $connection->userName = $session->name;
    $connection->subscriptions = [];
    $connection->send(json_encode(['type' => 'welcome']));
};
$server->onMessage = function (TcpConnection $connection, string $raw) {
    if (!validSession($connection)) {
        $connection->close();
        return;
    }
    $data = json_decode($raw, true);
    $identifier = $data['identifier'] ?? '';
    $params = json_decode($identifier, true);
    if (!is_array($data) || !is_array($params)) {
        return;
    }
    if (($data['command'] ?? '') === 'unsubscribe') {
        if (isset($connection->subscriptions[$identifier])) {
            releasePresence($connection, $connection->subscriptions[$identifier]);
            unset($connection->subscriptions[$identifier]);
        }
        return;
    }
    if (($data['command'] ?? '') === 'subscribe') {
        if (isset($connection->subscriptions[$identifier])) {
            $connection->send(json_encode(['type' => 'confirm_subscription', 'identifier' => $identifier]));
            return;
        }
        $channel = $params['channel'] ?? '';
        $room = null;
        $stream = null;
        $allowed = true;
        if (in_array($channel, ['RoomMessagesChannel', 'RoomChannel', 'PresenceChannel', 'TypingNotificationsChannel'])) {
            $room = $channel === 'RoomMessagesChannel' ? app(RailsCrypto::class)->verifyStream($params['signed_stream_name'] ?? '') : (int) ($params['room_id'] ?? 0);
            $allowed = $room && DB::table('memberships')->where('room_id', $room)->where('user_id', $connection->userId)->exists();
            $stream = $channel === 'RoomMessagesChannel' ? 'room_'.$room.'_messages' : ($channel === 'TypingNotificationsChannel' ? 'room_'.$room.'_typing' : null);
        } elseif ($channel === 'Turbo::StreamsChannel') {
            $name = app(RailsCrypto::class)->verifyStreamName($params['signed_stream_name'] ?? '');
            $personal = rtrim(base64_encode('gid://campfire/User/'.$connection->userId), '=').':rooms';
            $allowed = $name === 'rooms' || $name === $personal;
            $stream = $name === 'rooms' ? 'rooms' : 'user_'.$connection->userId.'_rooms';
        } elseif ($channel === 'UnreadRoomsChannel') {
            $stream = 'user_'.$connection->userId.'_unreads';
        } elseif ($channel === 'ReadRoomsChannel') {
            $stream = 'user_'.$connection->userId.'_reads';
        } elseif ($channel !== 'HeartbeatChannel') {
            $allowed = false;
        }
        if (!$allowed) {
            $connection->send(json_encode(['type' => 'reject_subscription', 'identifier' => $identifier]));
            return;
        }
        $connection->subscriptions[$identifier] = ['room' => $room, 'stream' => $stream, 'channel' => $channel];
        $connection->send(json_encode(['type' => 'confirm_subscription', 'identifier' => $identifier]));
        if ($channel === 'PresenceChannel') {
            DB::table('memberships')->where('room_id', $room)->where('user_id', $connection->userId)->update(['connections' => DB::raw('connections+1'), 'connected_at' => now(), 'unread_at' => null]);
            app(Broadcasts::class)->publish('user_'.$connection->userId.'_reads', ['roomId' => $room]);
        }
        return;
    }
    if (($data['command'] ?? '') === 'message') {
        $subscription = $connection->subscriptions[$identifier] ?? null;
        $payload = json_decode($data['data'] ?? '', true);
        if (!$subscription || !is_array($payload)) {
            return;
        }
        if ($subscription['room'] && !DB::table('memberships')->where('room_id', $subscription['room'])->where('user_id', $connection->userId)->exists()) {
            unset($connection->subscriptions[$identifier]);
            return;
        }
        if ($subscription['channel'] === 'HeartbeatChannel') {
            $connection->send(json_encode(['identifier' => $identifier, 'message' => ['type' => 'heartbeat']]));
        } elseif ($subscription['channel'] === 'TypingNotificationsChannel' && in_array($payload['action'] ?? '', ['start', 'stop'])) {
            app(Broadcasts::class)->publish($subscription['stream'], ['action' => $payload['action'], 'user' => ['id' => $connection->userId, 'name' => $connection->userName]]);
        }
    }
};
$server->onClose = function (TcpConnection $connection) {
    foreach ($connection->subscriptions ?? [] as $subscription) {
        releasePresence($connection, $subscription);
    }
};
$server->onWorkerStart = function (Worker $worker) {
    $path = storage_path('events.log');
    touch($path);
    $offset = filesize($path);
    Timer::add(3, function () use ($worker) {
        foreach ($worker->connections as $connection) {
            if (!validSession($connection)) {
                $connection->close();
            } else {
                $connection->send(json_encode(['type' => 'ping', 'message' => time()]));
            }
        }
    });
    Timer::add(0.02, function () use ($worker, $path, &$offset) {
        $file = fopen($path, 'c+');
        if (!$file) {
            return;
        }
        flock($file, LOCK_EX);
        $length = fstat($file)['size'];
        if ($offset > $length) {
            $offset = 0;
        }
        fseek($file, $offset);
        $events = [];
        while (($line = fgets($file)) !== false) {
            $event = json_decode($line, true);
            if (is_array($event)) {
                $events[] = $event;
            }
        }
        $offset = ftell($file);
        if ($length > 16 * 1024 * 1024) {
            ftruncate($file, 0);
            $offset = 0;
        }
        flock($file, LOCK_UN);
        fclose($file);
        foreach ($events as $event) {
            foreach ($worker->connections as $connection) {
                if (!validSession($connection)) {
                    $connection->close();
                    continue;
                }
                foreach ($connection->subscriptions as $identifier => $subscription) {
                    if ($subscription['stream'] !== ($event['stream'] ?? null)) {
                        continue;
                    }
                    if ($subscription['room'] && !DB::table('memberships')->where('room_id', $subscription['room'])->where('user_id', $connection->userId)->exists()) {
                        unset($connection->subscriptions[$identifier]);
                        $connection->send(json_encode(['type' => 'reject_subscription', 'identifier' => $identifier]));
                        continue;
                    }
                    $connection->send(json_encode(['identifier' => $identifier, 'message' => $event['message']]));
                }
            }
        }
    });
};
Worker::runAll();
